{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michinar.ai/schema/tool-music/1.json",
  "title": "Narai's music payloads",
  "description": "The music.* payloads Narai owns. A manifest that declares one declares this schema, unchanged.",
  "payloads": {
    "music.played@1": {
      "$defs": {
        "Note": {
          "additionalProperties": false,
          "properties": {
            "pitch": {
              "description": "MIDI note number (60 is middle C)",
              "maximum": 127,
              "minimum": 0,
              "title": "Pitch",
              "type": "integer"
            },
            "at_ms": {
              "description": "ms from the task's start, as the tool heard it",
              "minimum": 0,
              "title": "At Ms",
              "type": "integer"
            },
            "string": {
              "anyOf": [
                {
                  "maximum": 12,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1 is the highest-pitched string",
              "title": "String"
            },
            "fret": {
              "anyOf": [
                {
                  "maximum": 36,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Fret"
            },
            "velocity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Velocity"
            }
          },
          "required": [
            "pitch",
            "at_ms"
          ],
          "title": "Note",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "music.played@1",
      "properties": {
        "notes": {
          "items": {
            "$ref": "#/$defs/Note"
          },
          "maxItems": 2000,
          "title": "Notes",
          "type": "array"
        },
        "latency_ms": {
          "anyOf": [
            {
              "description": "The latency the tool measured, in ms, sent with what it reports",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "notes"
      ],
      "title": "Played",
      "type": "object"
    },
    "music.neck-preset@1": {
      "additionalProperties": false,
      "description": "music.neck-preset@1: a Neck, as a step sets it up",
      "properties": {
        "tuning": {
          "description": "MIDI pitch per string, lowest string first",
          "items": {
            "type": "integer"
          },
          "maxItems": 12,
          "minItems": 4,
          "title": "Tuning",
          "type": "array"
        },
        "frets": {
          "maximum": 36,
          "minimum": 12,
          "title": "Frets",
          "type": "integer"
        },
        "capo": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capo"
        },
        "handed": {
          "enum": [
            "right",
            "left"
          ],
          "title": "Handed",
          "type": "string"
        },
        "labels": {
          "enum": [
            "none",
            "notes",
            "intervals",
            "degrees"
          ],
          "title": "Labels",
          "type": "string"
        }
      },
      "required": [
        "tuning",
        "frets",
        "handed",
        "labels"
      ],
      "title": "NeckPreset",
      "type": "object"
    },
    "music.neck-state@1": {
      "$defs": {
        "Neck": {
          "additionalProperties": false,
          "description": "A neck's setup: the one shape `music.neck-preset@1` is and `music.neck-state@1` holds.",
          "properties": {
            "tuning": {
              "description": "MIDI pitch per string, lowest string first",
              "items": {
                "type": "integer"
              },
              "maxItems": 12,
              "minItems": 4,
              "title": "Tuning",
              "type": "array"
            },
            "frets": {
              "maximum": 36,
              "minimum": 12,
              "title": "Frets",
              "type": "integer"
            },
            "capo": {
              "anyOf": [
                {
                  "maximum": 12,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Capo"
            },
            "handed": {
              "enum": [
                "right",
                "left"
              ],
              "title": "Handed",
              "type": "string"
            },
            "labels": {
              "enum": [
                "none",
                "notes",
                "intervals",
                "degrees"
              ],
              "title": "Labels",
              "type": "string"
            }
          },
          "required": [
            "tuning",
            "frets",
            "handed",
            "labels"
          ],
          "title": "Neck",
          "type": "object"
        },
        "Position": {
          "additionalProperties": false,
          "properties": {
            "string": {
              "maximum": 12,
              "minimum": 1,
              "title": "String",
              "type": "integer"
            },
            "fret": {
              "maximum": 36,
              "minimum": 0,
              "title": "Fret",
              "type": "integer"
            },
            "label": {
              "anyOf": [
                {
                  "maxLength": 16,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Label"
            }
          },
          "required": [
            "string",
            "fret"
          ],
          "title": "Position",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "music.neck-state@1",
      "properties": {
        "preset": {
          "$ref": "#/$defs/Neck"
        },
        "highlighted": {
          "items": {
            "$ref": "#/$defs/Position"
          },
          "maxItems": 144,
          "title": "Highlighted",
          "type": "array"
        },
        "playing": {
          "title": "Playing",
          "type": "boolean"
        }
      },
      "required": [
        "preset",
        "playing"
      ],
      "title": "NeckState",
      "type": "object"
    },
    "music.tab-practice@1": {
      "additionalProperties": false,
      "description": "music.tab-practice@1",
      "properties": {
        "passage": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Passage",
          "type": "string"
        },
        "notes_attempted": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Notes Attempted",
          "type": "integer"
        },
        "notes_matched": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Notes Matched",
          "type": "integer"
        },
        "tempo_bpm": {
          "maximum": 400,
          "minimum": 20,
          "title": "Tempo Bpm",
          "type": "integer"
        },
        "latency_ms": {
          "anyOf": [
            {
              "description": "The latency the tool measured, in ms, sent with what it reports",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "passage",
        "notes_attempted",
        "notes_matched",
        "tempo_bpm"
      ],
      "title": "TabPractice",
      "type": "object"
    },
    "music.taps@1": {
      "$defs": {
        "Tap": {
          "additionalProperties": false,
          "properties": {
            "at_ms": {
              "description": "ms from the first beat after the count-in, as the tool heard it",
              "minimum": 0,
              "title": "At Ms",
              "type": "integer"
            },
            "velocity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "how hard; carried, not judged in @1",
              "title": "Velocity"
            }
          },
          "required": [
            "at_ms"
          ],
          "title": "Tap",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "music.taps@1",
      "properties": {
        "taps": {
          "items": {
            "$ref": "#/$defs/Tap"
          },
          "maxItems": 2000,
          "title": "Taps",
          "type": "array"
        },
        "source": {
          "description": "how the tool heard the taps; `mic` is onsets the tool detected, never audio",
          "enum": [
            "touch",
            "key",
            "midi",
            "mic"
          ],
          "title": "Source",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "description": "The latency the tool measured, in ms, sent with what it reports",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "taps",
        "source"
      ],
      "title": "Taps",
      "type": "object"
    },
    "music.cycle-preset@1": {
      "additionalProperties": false,
      "description": "music.cycle-preset@1: a rhythmic cycle as a step sets it up, a tala or a meter. The cycle's structure is here, not\nonly its name: `beats` in `groups` (a tala's divisions, a meter's bars), a clap or a wave per group, a syllable per\nbeat. Its rules across fields (the groups sum to the beats; one hand per group; one syllable per beat) are not in\nthis JSON Schema: Narai checks them with its own model wherever a payload is checked, and a tool must not take a\npreset that passes the schema alone as one Narai would send.",
      "properties": {
        "system": {
          "enum": [
            "tala",
            "meter"
          ],
          "title": "System",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rupak, adi, 4/4",
          "title": "Name"
        },
        "beats": {
          "maximum": 64,
          "minimum": 1,
          "title": "Beats",
          "type": "integer"
        },
        "groups": {
          "items": {
            "maximum": 64,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "hands": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "clap",
                  "wave"
                ],
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "one per group",
          "title": "Hands"
        },
        "syllables": {
          "anyOf": [
            {
              "items": {
                "maxLength": 16,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "one per beat",
          "title": "Syllables"
        },
        "subdivision": {
          "default": 1,
          "description": "pulses per beat",
          "maximum": 8,
          "minimum": 1,
          "title": "Subdivision",
          "type": "integer"
        },
        "tempo_bpm": {
          "maximum": 400,
          "minimum": 20,
          "title": "Tempo Bpm",
          "type": "integer"
        },
        "count_in_beats": {
          "default": 0,
          "description": "beats before the first; the clock starts after",
          "maximum": 16,
          "minimum": 0,
          "title": "Count In Beats",
          "type": "integer"
        },
        "cycles": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Cycles",
          "type": "integer"
        }
      },
      "required": [
        "system",
        "beats",
        "groups",
        "tempo_bpm"
      ],
      "title": "CyclePreset",
      "type": "object"
    }
  }
}
