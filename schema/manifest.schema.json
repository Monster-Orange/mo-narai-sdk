{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michinar.ai/schema/tool-manifest/1.json",
  "$defs": {
    "Capabilities": {
      "additionalProperties": false,
      "description": "What the tool's frame may use; anything not listed here is not granted. A device (`Grant`) is used only in a\nlaunch whose step grants it.",
      "properties": {
        "audio_out": {
          "default": false,
          "title": "Audio Out",
          "type": "boolean"
        },
        "microphone": {
          "default": false,
          "title": "Microphone",
          "type": "boolean"
        },
        "network": {
          "default": "none",
          "enum": [
            "none",
            "declared"
          ],
          "title": "Network",
          "type": "string"
        }
      },
      "title": "Capabilities",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "description": "A physical device paired through the SDK (a MIDI keyboard, a sensor).",
      "properties": {
        "kinds": {
          "items": {
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        }
      },
      "title": "Device",
      "type": "object"
    },
    "Embed": {
      "additionalProperties": false,
      "description": "A page Narai frames. `sdk: none` is a passive tool: shown, never spoken to.",
      "properties": {
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "pattern": "^https://\\S+$",
              "type": "string"
            },
            {
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_~-][A-Za-z0-9._~-]*(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)*$",
              "type": "string"
            }
          ],
          "description": "the tool's page: an https URL it hosts itself (its origin is the frame's origin), or one of its files by relative path, hosted by Narai at the tool's own origin in each environment",
          "title": "Url"
        },
        "sdk": {
          "pattern": "^\\^[1-9]\\d*$|^none$",
          "title": "Sdk",
          "type": "string"
        }
      },
      "required": [
        "url",
        "sdk"
      ],
      "title": "Embed",
      "type": "object"
    },
    "File": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "File",
      "type": "object"
    },
    "Import": {
      "additionalProperties": false,
      "description": "Files a learner brings in from the tool (an export), by media type.",
      "properties": {
        "accepts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Accepts",
          "type": "array"
        }
      },
      "required": [
        "accepts"
      ],
      "title": "Import",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A page opened in its own tab; `{name}` placeholders are filled from the preset.",
      "properties": {
        "url": {
          "maxLength": 500,
          "pattern": "^https://\\S+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "Link",
      "type": "object"
    },
    "Publisher": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "maxLength": 500,
          "pattern": "^https://\\S+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "Publisher",
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "description": "A headless tool reached over MCP: it renders or computes, it holds no learner.",
      "properties": {
        "mcp": {
          "maxLength": 500,
          "pattern": "^https://\\S+$",
          "title": "Mcp",
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "mcp",
        "tools"
      ],
      "title": "Service",
      "type": "object"
    },
    "Surfaces": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "embed": {
          "anyOf": [
            {
              "$ref": "#/$defs/Embed"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "link": {
          "anyOf": [
            {
              "$ref": "#/$defs/Link"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/Service"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "import": {
          "anyOf": [
            {
              "$ref": "#/$defs/Import"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/Device"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Surfaces",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One version of one tool, as its publisher declares it.",
  "properties": {
    "id": {
      "description": "publisher/name",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "description": "semver",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "title": "Version",
      "type": "string"
    },
    "sdk": {
      "description": "the SDK major range the tool is built against",
      "pattern": "^\\^[1-9]\\d*$",
      "title": "Sdk",
      "type": "string"
    },
    "publisher": {
      "$ref": "#/$defs/Publisher"
    },
    "name": {
      "anyOf": [
        {
          "additionalProperties": false,
          "maxProperties": 20,
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
              "type": "string"
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the tool's name as a learner reads it, by language: Narai shows the learner's, else any, else the id's tool slug title-cased",
      "title": "Name"
    },
    "surfaces": {
      "$ref": "#/$defs/Surfaces"
    },
    "payloads": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "family.name@N -> the JSON Schema of that payload",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+@[1-9]\\d*$"
      },
      "title": "Payloads",
      "type": "object"
    },
    "preset_schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the payload a step's preset is written in",
      "title": "Preset Schema"
    },
    "state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the payload the tool's state is in (tool.state): what it shows, never the learner",
      "title": "State"
    },
    "answers": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "item kind -> the payload it answers in",
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Answers",
      "type": "object"
    },
    "task_payloads": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "item kind -> the payload its task carries (what to show), for kinds that carry one",
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Task Payloads",
      "type": "object"
    },
    "practice": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "activity -> the payload it is set up with",
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_-]*)*$"
      },
      "title": "Practice",
      "type": "object"
    },
    "commands": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "command the Tutor may send -> its payload",
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_-]*)*$"
      },
      "title": "Commands",
      "type": "object"
    },
    "assist": {
      "default": "none",
      "enum": [
        "honors",
        "none"
      ],
      "title": "Assist",
      "type": "string"
    },
    "locales": {
      "items": {
        "type": "string"
      },
      "title": "Locales",
      "type": "array"
    },
    "conventions": {
      "description": "payloads naming a convention the tool follows",
      "items": {
        "type": "string"
      },
      "title": "Conventions",
      "type": "array"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "files": {
      "description": "the release's files, sorted by path",
      "items": {
        "$ref": "#/$defs/File"
      },
      "title": "Files",
      "type": "array"
    },
    "bundle_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bundle Digest"
    }
  },
  "required": [
    "id",
    "version",
    "sdk",
    "publisher",
    "surfaces"
  ],
  "title": "ToolManifest",
  "type": "object"
}
