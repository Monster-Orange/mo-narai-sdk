  "components": {
    "schemas": {
      "LaunchIn": {
        "properties": {
          "preset": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset"
          }
        },
        "type": "object",
        "title": "LaunchIn"
      },
      "LaunchOut": {
        "properties": {
          "launch": {
            "type": "string",
            "pattern": "^lch_[A-Za-z0-9_-]{8,64}$",
            "title": "Launch"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "launch",
          "expires_at"
        ],
        "title": "LaunchOut"
      },
      "PublisherIn": {
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https://\\S+$",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "url"
        ],
        "title": "PublisherIn"
      },
      "PublisherOut": {
        "properties": {
          "org_id": {
            "type": "string",
            "format": "uuid",
            "title": "Org Id"
          },
          "org_name": {
            "type": "string",
            "title": "Org Name"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "name": {
            "anyOf": [
              {
