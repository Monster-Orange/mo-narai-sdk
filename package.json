{
  "name": "@michinarai/sdk",
  "version": "0.2.0",
  "description": "Build tools that run inside Narai lessons: the manifest, the embed runtime and a local test harness.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monster-Orange/mo-narai-sdk.git"
  },
  "homepage": "https://github.com/Monster-Orange/mo-narai-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host-entry.d.ts",
      "import": "./dist/host-entry.js"
    },
    "./payloads": {
      "types": "./dist/payloads.d.ts",
      "import": "./dist/payloads.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/generated/validators.js src/generated/validators.d.ts dist/generated/ && cp src/harness/page.html dist/harness/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "14.0.0",
    "json-schema-to-typescript": "15.0.4",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
